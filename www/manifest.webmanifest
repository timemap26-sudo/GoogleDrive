{
  "name": "街景兜風 Street Drive",
  "short_name": "街景兜風",
  "description": "把 Google 街景串起來，用方向鍵像開車一樣逛街道",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#0f172a",
